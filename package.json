{
  "name": "wake-grokbot",
  "version": "0.2.0",
  "description": "Local inbox and wake-up CLI between agents, with idempotent receipts, rate limits and leak guards. Grok Bot routines first; script channel for other systems.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wake-grokbot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "docs",
    "skills",
    "examples",
    "wake-grokbot.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "BOOTSTRAP.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "grok-bot",
    "agents",
    "inbox",
    "wake",
    "webhook",
    "dispatch",
    "receipts",
    "grok",
    "xai",
    "claude-code",
    "codex",
    "ai-agents",
    "agent-to-agent",
    "a2a",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blicae8917/wake-grokbot.git"
  },
  "homepage": "https://github.com/Blicae8917/wake-grokbot#readme",
  "bugs": {
    "url": "https://github.com/Blicae8917/wake-grokbot/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
